<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- Окно -->
	<SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E"/>
	<SolidColorBrush x:Key="WindowForegroundBrush" Color="#F0F0F0"/>

	<!-- Активная кнопка -->
	<SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#373737"/>
	<SolidColorBrush x:Key="ButtonForegroundBrush" Color="#F5F5F5"/>
	<SolidColorBrush x:Key="ButtonBorderBrush" Color="#555555"/>

	<!-- Наведение и нажатие -->
	<SolidColorBrush x:Key="ButtonHoverBrush" Color="#4B4B4B"/>
	<SolidColorBrush x:Key="ButtonPressedBrush" Color="#235A91"/>

	<!-- Неактивная кнопка -->
	<SolidColorBrush x:Key="DisabledButtonBackgroundBrush" Color="#262626"/>
	<SolidColorBrush x:Key="DisabledButtonForegroundBrush" Color="#7D7D7D"/>
	<SolidColorBrush x:Key="DisabledButtonBorderBrush" Color="#373737"/>

</ResourceDictionary>

