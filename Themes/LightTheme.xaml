<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- Окно -->
	<SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F5F5"/>
	<SolidColorBrush x:Key="WindowForegroundBrush" Color="#1E1E1E"/>

	<!-- Активная кнопка -->
	<SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#E6E6E6"/>
	<SolidColorBrush x:Key="ButtonForegroundBrush" Color="#1E1E1E"/>
	<SolidColorBrush x:Key="ButtonBorderBrush" Color="#BEBEBE"/>

	<!-- Наведение и нажатие -->
	<SolidColorBrush x:Key="ButtonHoverBrush" Color="#D7E6F5"/>
	<SolidColorBrush x:Key="ButtonPressedBrush" Color="#B9D7F5"/>

	<!-- Неактивная кнопка -->
	<SolidColorBrush x:Key="DisabledButtonBackgroundBrush" Color="#EEEEEE"/>
	<SolidColorBrush x:Key="DisabledButtonForegroundBrush" Color="#999999"/>
	<SolidColorBrush x:Key="DisabledButtonBorderBrush" Color="#DCDCDC"/>

</ResourceDictionary>

